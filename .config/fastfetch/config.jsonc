{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "$HOME/.config/fastfetch/png/miku.png",
        "type": "kitty-icat",
        "width": 20,
        "height": 15,
        "padding": {
            "top": 1,
            "right": 5,
            "left": 1
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "break",

        {
            "type": "title",
            "key": " ",
            "format": "{user-name}@{host-name}",
            "outputColor": "34"
        },

        {
            "type": "custom",
            "format": "─────────────────────────────────────────",
            "keyColor": "34"
        },

        {
            "type": "os",
            "key": "  ",
            "keyColor": "34"
        },

        {
            "type": "kernel",
            "key": "  ",
            "keyColor": "34"
        },

        {
            "type": "wm",
            "key": "  ",
            "keyColor": "34"
        },

        {
            "type": "shell",
            "key": "  ",
            "keyColor": "34"
        },

        {
            "type": "terminal",
            "key": "  ",
            "keyColor": "34"
        },

        {
            "type": "packages",
            "key": "󰏖  ",
            "keyColor": "34"
        },

        {
            "type": "uptime",
            "key": "󰔛  ",
            "keyColor": "34"
        },

        {
            "type": "memory",
            "key": "󰍛  ",
            "keyColor": "34"
        },

        {
            "type": "gpu",
            "key": "󰢮  ",
            "keyColor": "34",
            "format": "{1} {2}"
        },

        "break"
    ]
}
